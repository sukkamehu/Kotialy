# Copy this file to .env and replace every password before starting the stack.
# Do not expose port 1883 directly to the internet. It is intended for your LAN.

HEISHAMON_MQTT_USERNAME=heishamon
HEISHAMON_MQTT_PASSWORD=replace-with-a-long-random-password
APP_MQTT_USERNAME=kotialy
APP_MQTT_PASSWORD=replace-with-a-different-long-random-password
ZIGBEE2MQTT_MQTT_USERNAME=zigbee2mqtt
ZIGBEE2MQTT_MQTT_PASSWORD=replace-with-a-third-long-random-password

# The MQTT root used in the Heishamon web configuration.
MQTT_BASE_TOPIC=panasonic_heat_pump
ZIGBEE_BASE_TOPIC=zigbee2mqtt

# Localization (fi = Finnish, en = English)
DEFAULT_LANGUAGE=fi
VITE_DEFAULT_LANGUAGE=fi

# Remote Authentication (LAN access bypasses login automatically)
AUTH_USERNAME=admin
AUTH_PASSWORD=replace-with-a-secure-admin-password
AUTH_VIEWER_USERNAME=viewer
AUTH_VIEWER_PASSWORD=replace-with-a-viewer-password
AUTH_SECRET=replace-with-a-random-32-char-secret
AUTH_TOKEN_DAYS=365

# Allowed Operating Modes in UI (4 = Lämmitys+KV, 3 = Käyttövesi, 0 = Lämmitys, 1 = Jäähdytys, 2 = Auto, etc.)
VITE_ALLOWED_OPERATING_MODES=4,3

# Camera / RTSP Monitoring
CAMERA_ENABLED=true
CAMERA_NAME=Pannuhuone / Tekninen tila
CAMERA_RTSP_URL=rtsp://admin:password@192.168.1.50:554/0/av1
CAMERA_MAIN_RTSP_URL=rtsp://admin:password@192.168.1.50:554/0/av0

# Cloudflare R2 Object Storage & Backup (from frontpics dev)
STORAGE_BACKEND=r2
CLOUDFLARE_ACCOUNT_ID=
R2_ACCOUNT_ID=
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET_NAME=your-storage-bucket
R2_PUBLIC_URL=https://photos.example.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_PREFIX=kotialy/

# Herrfors Electricity Portal Integration
HERRFORS_ENABLED=true
HERRFORS_CO_ID=your_contract_or_coid
HERRFORS_USERNAME=your_email@example.com
HERRFORS_PASSWORD=your_password
HERRFORS_SESSION_TOKEN=
HERRFORS_REFRESH_INTERVAL_MINUTES=5

# TP-Link Tapo P115 Smart Plugs
TAPO_USERNAME=your_tapo_email@example.com
TAPO_PASSWORD=your_tapo_password

# Tuya / Smart Life IoT Cloud Integration
TUYA_CLIENT_ID=your_tuya_access_id
TUYA_CLIENT_SECRET=your_tuya_access_secret
TUYA_BASE_URL=https://openapi.tuyaeu.com
TUYA_SAUNA_DEVICE_ID=your_sauna_relay_device_id
TUYA_SAUNA_LOCAL_IP=192.168.68.70
TUYA_SAUNA_LOCAL_KEY=your_tuya_local_key
TUYA_SAUNA_MAX_HOURS=3



