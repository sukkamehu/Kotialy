# Copy this file to .env and replace every password before starting the stack.
# Do not expose port 1883 directly to the internet. It is intended for your LAN.

HEISHAMON_MQTT_USERNAME=heishamon
HEISHAMON_MQTT_PASSWORD=replace-with-a-long-random-password
APP_MQTT_USERNAME=kotialy
APP_MQTT_PASSWORD=replace-with-a-different-long-random-password
ZIGBEE2MQTT_MQTT_USERNAME=zigbee2mqtt
ZIGBEE2MQTT_MQTT_PASSWORD=replace-with-a-third-long-random-password

# The MQTT root used in the Heishamon web configuration.
MQTT_BASE_TOPIC=panasonic_heat_pump
ZIGBEE_BASE_TOPIC=zigbee2mqtt

# Localization (fi = Finnish, en = English)
DEFAULT_LANGUAGE=fi
VITE_DEFAULT_LANGUAGE=fi

# Remote Authentication (LAN access bypasses login automatically)
AUTH_USERNAME=admin
AUTH_PASSWORD=replace-with-a-secure-admin-password
AUTH_VIEWER_USERNAME=viewer
AUTH_VIEWER_PASSWORD=replace-with-a-viewer-password
AUTH_SECRET=replace-with-a-random-32-char-secret
AUTH_TOKEN_DAYS=365

